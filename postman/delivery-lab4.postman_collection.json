        {
          "name": "9a. Список заказов клиента (пагинация)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Client-Id",
                "value": "client-demo"
              }
            ],
            "url": {
              "raw": "{{gw}}/api/v1/orders?page=1&size=10",
              "host": [
                "{{gw}}"
              ],
              "path": [
                "api",
