        {
          "name": "6. Заказ ASSIGNED (payment.completed → dispatch → courier_assigned)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gw}}/api/v1/orders/{{orderId}}",
