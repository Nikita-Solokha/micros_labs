        {
          "name": "4. Через SEARCH_TIMEOUT (20 с) — заказ CANCELLED",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gw}}/api/v1/orders/{{orderId}}",
              "host": [
                "{{gw}}"
              ],
              "path": [
                "api",
                "v1",
                "orders",
                "{{orderId}}"
              ]
            },
            "description": "Запрос ждёт 25 секунд перед отправкой: dispatch-service публикует dispatch.search_failed по таймауту."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
