                  "pm.collectionVariables.set(\"orderId\", o.id);",
                  "pm.collectionVariables.set(\"paymentId\", o.paymentId);",
                  "pm.collectionVariables.set(\"paymentUrl\", o.paymentUrl);",
                  "pm.test(\"status = PENDING_PAYMENT\", () => pm.expect(o.status).to.eql(\"PENDING_PAYMENT\"));"
                ]
              }
            }
          ]
        },
        {
