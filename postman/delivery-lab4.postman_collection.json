  },
  "variable": [
    {
      "key": "gw",
      "value": "http://localhost:8080"
    },
    {
      "key": "payment",
      "value": "http://localhost:8083"
    },
    {
      "key": "notify",
      "value": "http://localhost:8084"
    },
    {
      "key": "courierId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "paymentId",
      "value": ""
    },
    {
      "key": "paymentUrl",
      "value": ""
    },
    {
      "key": "idemKey",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Успешный сценарий (happy path)",
      "item": [
        {
          "name": "1. Курьер выходит на смену",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gw}}/api/v1/couriers/shifts",
              "host": [
                "{{gw}}"
              ],
              "path": [
                "api",
                "v1",
                "couriers",
                "shifts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courierId\": \"{{courierId}}\",\n  \"action\": \"START_SHIFT\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"courierId\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"status = ONLINE\", () => pm.expect(pm.response.json().status).to.eql(\"ONLINE\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Курьер передаёт координаты (центр Ростова)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gw}}/api/v1/dispatch/location",
              "host": [
                "{{gw}}"
              ],
              "path": [
                "api",
                "v1",
                "dispatch",
                "location"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courierId\": \"{{courierId}}\",\n  \"lat\": 47.2357,\n  \"lon\": 39.7015,\n  \"status\": \"ONLINE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
