            "body": {
              "mode": "raw",
              "raw": "{\n  \"originAddress\": \"г. Ростов-на-Дону, пл. Гагарина, 1\",\n  \"destinationAddress\": \"г. Ростов-на-Дону, ул. Большая Садовая, 105\",\n  \"weight\": 2.5\n}",
              "options": {
