                "orders"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            },
            "description": "Список заказов клиента client-demo, новые сначала. Параметры page и size — пагинация (size от 1 до 100)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"есть total, page, size, items\", () => { pm.expect(r).to.have.keys(\"total\",\"page\",\"size\",\"items\"); });",
                  "pm.test(\"наш заказ в списке\", () => pm.expect(r.items.map(o => o.id)).to.include(pm.collectionVariables.get(\"orderId\")));"
                ]
